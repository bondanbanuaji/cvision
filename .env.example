# Database connection (Prisma/MySQL)
DATABASE_URL="mysql://username:password@localhost:3306/your_database_name"

# Authentication secret for NextAuth
# Generate a real one using: openssl rand -base64 32
AUTH_SECRET="your_nextauth_secret_here"

# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini model fallback chain (comma-separated, tried in order if quota is hit)
# gemini-2.5-flash       → fast new generation model
# gemini-2.0-flash       → standard fast model
# gemini-flash-latest    → fallback alias
GEMINI_MODEL="gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest"
